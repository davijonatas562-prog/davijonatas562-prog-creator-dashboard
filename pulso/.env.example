# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Projeto Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_..., o nome que o botão Connect do Supabase usa)

# Somente servidor. Usada para excluir contas e (Fase 3) pelos conectores.
# NUNCA use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links dos e-mails de confirmação/recuperação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Análise de sentimento por IA (Claude). Sem a chave, as menções ficam "não classificadas"
# e a correção manual continua funcionando. Gravar as análises também exige a SERVICE_ROLE_KEY.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na classificação (padrão: claude-opus-5-5)
# PULSO_SENTIMENT_MODEL=claude-opus-5-5
